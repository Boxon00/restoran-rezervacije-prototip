APP_NAME="Rezervacije Restorana"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Za lokalni razvoj bez MySQL servera moguce je koristiti SQLite:
# DB_CONNECTION=sqlite
# DB_DATABASE=/apsolutna/putanja/do/database.sqlite

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restoran_rezervacije
DB_USERNAME=root
DB_PASSWORD=Jasambojan123

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

SANCTUM_STATEFUL_DOMAINS=localhost:5173
# Napomena: ova promenljiva se trenutno NE koristi (projekat radi na čistom
# Bearer-token Sanctum modelu, ne na cookie-based SPA modelu — videti komentar
# u bootstrap/app.php). Ostavljena je ovde samo kao referenca u slučaju da se
# sistem kasnije prebaci na cookie-based SPA autentikaciju.
FRONTEND_URL=http://localhost:5173
